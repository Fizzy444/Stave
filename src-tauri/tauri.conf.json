{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stave",
  "version": "0.1.4",
  "identifier": "com.mithun.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stave",
        "width": 1100,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Fizzy444/Stave/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MUEwQUQwQTEzRDlGMzAKUldRd256MmgwQW9heHA1ZVZ3NGpwNXo2VHFFakE3c2ZkZW5YbHU4cG1FeDcvR1NCUE9TdFpKcSsK"
    }
  }
}